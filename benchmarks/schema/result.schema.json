{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ariiies/lucis/benchmarks/result.schema.json",
  "title": "Lucis benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at_utc",
    "environment",
    "configuration",
    "datasets",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
