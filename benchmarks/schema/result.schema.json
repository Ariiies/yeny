{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ariiies/yeny/benchmarks/result.schema.json",
  "title": "Yeny benchmark result",
  "description": "Documentation schema for the benchmark result contract. Runtime validation is performed by benchmarks.results.validate_result without external dependencies; this file mirrors that contract for readers and tooling.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at_utc",
    "finished_at_utc",
    "environment",
    "configuration",
    "datasets",
    "queries",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "description": "Must be equal to or later than started_at_utc."
    },
    "environment": {
      "type": "object",
      "description": "Machine metadata: Python version/implementation/executable, Yeny version, OS fields, CPU model, logical CPUs, total RAM bytes, psutil version, memory mechanisms, perf_counter resolution, git commit/dirty."
    },
    "configuration": {
      "type": "object",
      "required": [
        "profile",
        "engines",
        "warmups",
        "repetitions",
        "require_memory"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["tiny", "small", "medium", "large"]
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["core", "lite"]
          }
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "require_memory": {
          "type": "boolean"
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile",
          "generator_version",
          "seed",
          "documents",
          "total_tokens",
          "vocabulary_nominal",
          "vocabulary_observed",
          "intentional_duplicates",
          "sha256"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "generator_version": {
            "const": "lexical_zipf_v1"
          },
          "seed": {
            "type": "integer"
          },
          "documents": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "vocabulary_nominal": {
            "type": "integer",
            "minimum": 0
          },
          "vocabulary_observed": {
            "type": "integer",
            "minimum": 0
          },
          "intentional_duplicates": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Must equal the frozen reference hash for the profile."
          }
        }
      }
    },
    "queries": {
      "type": "object",
      "required": ["version", "dataset_sha256", "queries", "sha256"],
      "properties": {
        "version": {
          "const": "queries_v1"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Must equal datasets[0].sha256."
        },
        "queries": {
          "const": 17
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Must equal the frozen reference query hash for the profile."
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "unit", "samples", "summary", "engine"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": ["ns", "bytes", "count"]
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "description": "Finite, non-negative numbers. Empty only when status is unavailable."
          },
          "summary": {
            "type": "object",
            "required": ["count", "min", "median", "p95", "max"],
            "description": "Must be exactly recomputed from samples; null values with count 0 only for unavailable measurements."
          },
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable"],
            "default": "ok"
          },
          "engine": {
            "type": "string",
            "enum": ["core", "lite"]
          },
          "backend": {
            "type": "string",
            "enum": ["json", "sqlite", "mmap"]
          },
          "phase": {
            "type": "string",
            "enum": ["build", "load_json", "load_sqlite", "load_mmap"]
          },
          "query_category": {
            "type": "string",
            "enum": ["common", "rare", "multi", "no_result", "repeated"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
