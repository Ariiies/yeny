include README.md
include LICENSE
include pyproject.toml

# Include all JSON files in the data directory (stopwords, etc.)
recursive-include src/lucis/data *.json

# Exclude test data and playground files
exclude playground.py playground2.py dataset.py
recursive-exclude test_data *
recursive-exclude tests *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
