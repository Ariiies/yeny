# ─────────────────────────────────────────────────────────────────────────────
# Yeny — Encrypted Search example configuration
#
# Copy to `.env` (same folder) and edit:   cp .env.example .env
# The real `.env` is git-ignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# Database (must ALREADY exist — the example only creates the table)
DATABASE_URL=mysql+pymysql://yeny_user:change-me@localhost:3306/yeny_encrypted_search

# Table mapping — point these at YOUR table
TABLE_NAME=leads
ID_COLUMN=id
TEXT_COLUMNS=name,email,number,ip
DATE_COLUMN=created_at
# ↑ leave DATE_COLUMN empty to disable temporal sharding:
# DATE_COLUMN=

# Yeny
# NOTE: change YENY_INDEX_NAME whenever you point to a different table,
# otherwise Yeny autoloads the previously saved index with the same name.
YENY_INDEX_NAME=encrypted_leads
YENY_ENGINE=lite
YENY_MEMORY_LIMIT_MB=512
YENY_STORAGE_DIR=./yeny_data

# Preprocessor — "false" for plain-text tables (preprocessor.py is then unused)
USE_ENCRYPTED_PREPROCESSOR=true

# Security — two INDEPENDENT secrets (only needed when the preprocessor is on)
# Generate real ones with:  python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET=replace-with-a-long-example-secret
TOKEN_HMAC_SECRET=replace-with-a-different-long-secret

# Runtime — optional background services in the playground
ENABLE_WORKER=true
ENABLE_HEALTH_MONITOR=true
WORKER_INTERVAL_SECONDS=60
HEALTH_INTERVAL_SECONDS=60

# Generators (seed scripts)
RANDOM_SEED=20260801
BATCH_SIZE=1000
